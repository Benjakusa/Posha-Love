# Copy to .env — real values in .env, secrets never committed.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173,http://localhost:8081

# Leave DATABASE_URL empty for Stage 1 (memory driver).
# Stage 2+: Neon Postgres connection string, e.g.
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/posha?sslmode=require
DATABASE_URL=

# Stage 2+: Upstash Redis, e.g. rediss://default:pass@xxx.upstash.io:6379
REDIS_URL=

JWT_SECRET=dev-only-secret-change-me-please-1234
JWT_EXPIRES_IN=4h
STORAGE_DRIVER=memory
GUEST_SESSION_TTL_SECONDS=14400
GUEST_VIDEO_MAX_SECONDS=120
FOLLOWER_VIDEO_MAX_SECONDS=1800
GATE_GUEST_ACCESS=on
