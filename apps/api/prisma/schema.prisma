// POSHA Prisma schema — Stage 1 minimal.
// Expand per docs/spec/10_SIMPLE_APP_SCOPE.md as we build stages.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgeLevel {
  L0
  G1
  L2
  L3
}

enum Role {
  guest
  member
  creator
  moderator
  admin
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  alias     String   @unique
  role      Role     @default(member)
  ageLevel  AgeLevel @default(L0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model GuestSession {
  id          String   @id @default(uuid())
  userId      String
  alias       String
  ipHash      String?
  uaHash      String?
  declaredAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Creator {
  id              String   @id @default(uuid())
  userId          String   @unique
  displayName     String
  handle          String   @unique
  bio             String?
  avatarKey       String?
  coverKey        String?
  category        String?  // music | comedy | education | fitness | lifestyle | other
  instagram       String?
  tiktok          String?
  youtube         String?
  xHandle         String?
  publicProfile   Boolean  @default(true)
  showVideos      Boolean  @default(true)
  showLives       Boolean  @default(true)
  subscriptionPriceMinor Int @default(20000)
  status          String   @default("pending") // pending | approved | rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model CreatorApplication {
  id              String   @id @default(uuid())
  userId          String
  displayName     String
  handle          String
  bio             String?
  avatarKey       String?
  coverKey        String?
  subscriptionPriceMinor Int
  rulesAccepted   Boolean  @default(false)
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Subscription {
  id               String   @id @default(uuid())
  subscriberId     String
  creatorId        String
  status           String   @default("active") // active | past_due | cancelled | expired
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([subscriberId, creatorId])
  @@index([subscriberId, status])
  @@index([creatorId])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  provider       String   @default("fake")
  providerRef    String?
  idempotencyKey String   @unique
  amountMinor    Int
  currency       String   @default("KES")
  status         String   @default("created") // created | pending | succeeded | failed | refunded
  purpose        String   @default("subscription")
  creatorId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
