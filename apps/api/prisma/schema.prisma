// POSHA Prisma schema — Stage 1 minimal.
// Expand per docs/spec/10_SIMPLE_APP_SCOPE.md as we build stages.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgeLevel {
  L0
  G1
  L2
  L3
}

enum Role {
  guest
  member
  creator
  moderator
  admin
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  alias     String   @unique
  role      Role     @default(member)
  ageLevel  AgeLevel @default(L0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model GuestSession {
  id          String   @id @default(uuid())
  userId      String
  alias       String
  ipHash      String?
  uaHash      String?
  declaredAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Creator {
  id              String   @id @default(uuid())
  userId          String   @unique
  displayName     String
  handle          String   @unique
  bio             String?
  categories      String[] @default([])
  languages       String[] @default([])
  country         String?
  avatarKey       String?
  coverKey        String?
  category        String?
  gender          String?  // male | female | trans | other
  ethnicity       String?  // black | white | asian | mixed | other
  orientation     String?  // straight | gay | lesbian | bisexual | other
  ageMin          Int?     @default(18)
  ageMax          Int?     @default(99)
  instagram       String?
  tiktok          String?
  youtube         String?
  xHandle         String?
  publicProfile   Boolean  @default(true)
  showVideos      Boolean  @default(true)
  showLives       Boolean  @default(true)
  subscriptionPriceMinor Int @default(20000)
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([gender])
  @@index([ethnicity])
}

model CreatorApplication {
  id              String   @id @default(uuid())
  userId          String
  displayName     String
  handle          String
  bio             String?
  avatarKey       String?
  coverKey        String?
  subscriptionPriceMinor Int
  rulesAccepted   Boolean  @default(false)
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Subscription {
  id               String   @id @default(uuid())
  subscriberId     String
  creatorId        String
  status           String   @default("active") // active | past_due | cancelled | expired
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([subscriberId, creatorId])
  @@index([subscriberId, status])
  @@index([creatorId])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  provider       String   @default("fake")
  providerRef    String?
  idempotencyKey String   @unique
  amountMinor    Int
  currency       String   @default("KES")
  status         String   @default("created") // created | pending | succeeded | failed | refunded
  purpose        String   @default("subscription")
  creatorId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Post {
  id        String   @id @default(uuid())
  creatorId String   // Creator.userId
  caption   String
  mediaKey  String   // R2 key
  mediaType String   @default("image") // image | video
  createdAt DateTime @default(now())

  comments  Comment[]

  @@index([creatorId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  parentId  String?
  authorId  String
  authorAlias String
  text      String
  createdAt DateTime @default(now())

  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes     CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model ScheduledLive {
  id          String   @id @default(uuid())
  creatorId   String
  title       String
  startsAt    DateTime
  status      String   @default("scheduled") // scheduled | live | ended
  createdAt   DateTime @default(now())

  @@index([creatorId])
  @@index([status])
  @@index([startsAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}
